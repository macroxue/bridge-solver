#!/usr/bin/env bash
# Auto-bump "?v=<hash>" cache-busting suffixes for any staged asset so
# browsers can't keep serving a stale cached copy after it changes.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Files referenced elsewhere by basename with a "<name>?v=<hash>"
# cache-busting suffix. solver.wasm/solver-no-simd.wasm are deliberately
# excluded: solver.js already embeds a content hash for each of them at
# build time.
ASSETS=(web/deals.js web/deal-parser.js web/declarer-columns.js web/par-score.js
        web/app.js web/worker.js web/shuffle-worker.js web/solver.js)

# Files that may contain references to the assets above.
REFERENCING_FILES=(web/index.html web/app.js web/worker.js web/shuffle-worker.js)

staged=$(git diff --cached --name-only)
is_staged() { grep -qx "$1" <<< "$staged"; }

# Repeat until nothing changes: bumping a reference re-stages the file that
# holds it, and if that file is itself an asset, its own references need
# bumping too (e.g. web/shuffle-worker.js -> web/app.js -> web/index.html).
changed=0
while :; do
  bumped=0
  for asset in "${ASSETS[@]}"; do
    is_staged "$asset" || continue

    hash=$(git hash-object "$asset" | cut -c1-8)
    name=${asset##*/}
    escaped=${name//./\\.}
    # Anchored so e.g. worker.js doesn't match inside shuffle-worker.js.
    pattern="([\"'/])${escaped}\?v=[A-Za-z0-9.]+"
    for file in "${REFERENCING_FILES[@]}"; do
      [ -f "$file" ] || continue
      grep -qE "$pattern" "$file" || continue
      before=$(git hash-object "$file")
      sed -i -E "s/${pattern}/\1${name}?v=${hash}/g" "$file"
      [ "$(git hash-object "$file")" != "$before" ] || continue
      git add "$file"
      is_staged "$file" || staged+=$'\n'"$file"
      bumped=1
      changed=1
    done
  done
  [ "$bumped" -eq 1 ] || break
done

if [ "$changed" -eq 1 ]; then
  echo "pre-commit: bumped cache-busting versions for changed assets"
fi
